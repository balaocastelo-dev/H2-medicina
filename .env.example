# =====================================================================
# VARIAVEIS DE AMBIENTE - copie para .env.local e preencha os valores.
# NUNCA faca commit do arquivo .env.local nem de valores reais.
#
# Aqui estao SO as variaveis que o codigo realmente le. Havia onze nomes
# nesta lista que nenhuma linha do sistema consultava -- provedor de
# e-mail, de IA, de pagamento. Quem fosse configurar o deploy perdia tempo
# procurando chave de servico que nao faz nada. E-mail, IA e pagamento sao
# configurados pelo painel, em Configuracoes, e ficam no banco.
# =====================================================================

# ---------------------------------------------------------------------
# OBRIGATORIAS. Sem as tres, o sistema sobe e nenhuma tela do painel
# abre. Teste com GET /api/health depois do deploy.
# ---------------------------------------------------------------------

# Publicas: vao para o navegador, e e assim que tem de ser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Servidor, NUNCA no navegador. Entre como "secret" na Vercel.
#
# Obrigatoria de fato, apesar do nome sugerir algo opcional: sem ela
# param o agendamento pelo site, a pagina /verificar, o portal do
# paciente, o comprovante publico e A CRIACAO DE QUALQUER USUARIO.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------
# OPCIONAIS
# ---------------------------------------------------------------------

# Endereco publico do sistema, usado no link impresso nos documentos.
# Sem ela, cai no endereco da Vercel e depois em localhost.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Slug da clinica, usado pelas telas publicas (/agendar, /verificar, /meu).
# O padrao e `h2`, que e o que o seed cria. Trocar o slug no banco sem
# trocar aqui faz as telas publicas responderem "unidade nao configurada".
NEXT_PUBLIC_DEFAULT_TENANT_SLUG=h2

# Conexao direta ao Postgres. So para rodar as migrations da sua maquina
# (`npm run db:push`). A aplicacao nao usa.
SUPABASE_DB_URL=

# Token do worker do scraper, que roda fora da Vercel (precisa de
# Playwright). Sem ele o worker nao autentica; o resto do sistema nao
# depende disso.
SCRAPER_WORKER_TOKEN=

# Chave de 32 bytes em base64 para cifrar segredo de conector.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# Hoje ela e apenas LIDA e conferida pelo healthcheck -- nao ha conector
# com segredo cifrado em uso. Fica aqui porque o dia em que houver, a
# chave precisa existir antes, e nao depois.
SECRETS_ENCRYPTION_KEY=
