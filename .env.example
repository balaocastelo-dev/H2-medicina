# =====================================================================
# VARIAVEIS DE AMBIENTE - copie para .env.local e preencha os valores.
# NUNCA faca commit do arquivo .env.local nem de valores reais.
# =====================================================================

# --- Supabase (publico: enviado ao navegador) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (servidor: NUNCA expor no navegador) ---
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=
SUPABASE_DB_URL=

# --- Aplicacao ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_TENANT_SLUG=h2

# --- Criptografia de segredos de conectores (32 bytes em base64) ---
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SECRETS_ENCRYPTION_KEY=

# --- Worker do scraper (opcional, ambiente compativel com Playwright) ---
SCRAPER_WORKER_TOKEN=
SCRAPER_ARTIFACTS_BUCKET=scraper-evidence

# --- Provedores externos (todos opcionais; configuraveis pelo painel) ---
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=
AI_PROVIDER=
AI_API_KEY=
PAYMENT_PROVIDER=
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=
